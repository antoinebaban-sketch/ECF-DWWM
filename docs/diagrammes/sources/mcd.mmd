    UTILISATEUR ---|"1,1"| a_avoir ---|"0,n"| ROLE
    UTILISATEUR ---|"0,n"| a_passer ---|"1,1"| COMMANDE
    UTILISATEUR ---|"0,n"| a_traiter ---|"0,1"| COMMANDE
    COMMANDE ---|"0,1"| a_concerner ---|"0,n"| MENU
    COMMANDE ---|"0,1"| a_choisir ---|"0,n"| THEME
    MENU ---|"0,1"| a_categoriser ---|"0,n"| THEME
    IMAGE ---|"1,1"| a_illustrer ---|"0,n"| MENU
